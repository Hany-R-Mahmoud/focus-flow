# Optional cloud collaboration. Leave unset to keep local-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public Turnstile site key. Keep the Turnstile secret key in Supabase only.
VITE_TURNSTILE_SITE_KEY=
# Canonical production URL, without a trailing slash. Required for sitemap.xml.
SITE_URL=
# Optional browser-side override; defaults to the current origin.
VITE_SITE_URL=
