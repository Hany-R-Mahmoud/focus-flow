# Public Neon HTTPS database base URL. NEVER use a postgresql:// connection string here.
# Neon JS derives Auth and Data API endpoints from this one URL.
VITE_NEON_URL=https://YOUR_ENDPOINT.c-7.eu-central-1.aws.neon.tech/focus_flow

# Public canonical origin. Needed for the optional Express-generated sitemap in non-Vercel hosting.
SITE_URL=https://focus-session-flow.vercel.app

# Focus Flow supports browser-local guest use even if VITE_NEON_URL is unset.
# Google OAuth client credentials and SMTP secrets belong in Neon Auth settings, not frontend env.
# Personal focus sessions and private reviews are stored locally in IndexedDB.
